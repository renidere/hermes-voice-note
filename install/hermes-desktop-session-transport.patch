@@ -0,0 +1,70 @@
+import { resolveSessionOwner } from '@/app/session/hooks/use-session-actions/utils'
+import { $gateway, retainGatewayForAgent } from '@/store/gateway'
+import { assertSessionOwnerResolved } from '@/store/session-owner-resolution'
+import { isSessionOwnerRoute, requestForSessionProfile, type SessionOwnerRoute } from '@/store/session-request-router'
+
+export async function retainPluginSession(
+  storedSessionId: string,
+  capturedOwner?: Pick<SessionOwnerRoute, 'connectionId' | 'profile'> | null
+) {
+  if (typeof storedSessionId !== 'string' || !storedSessionId.trim()) {
+    throw new Error('A nonempty stored session id is required')
+  }
+
+  if (
+    capturedOwner != null &&
+    (typeof capturedOwner !== 'object' ||
+      ![capturedOwner.connectionId, capturedOwner.profile].every(
+        value => typeof value === 'string' && value.length > 0 && value === value.trim()
+      ))
+  ) {
+    throw new Error('Session owner must include nonempty connectionId and profile without surrounding whitespace')
+  }
+
+  const resolved = capturedOwner
+    ? { connectionId: capturedOwner.connectionId, profile: capturedOwner.profile }
+    : await resolveSessionOwner(storedSessionId)
+
+  const owner = isSessionOwnerRoute(resolved) ? { ...resolved } : resolved
+  assertSessionOwnerResolved(owner, { method: 'session.resume', sessionId: storedSessionId })
+  const profile = isSessionOwnerRoute(owner) ? owner.profile : owner
+  // Only the native sole-topology gate above can admit an unknown owner.
+  const gateway = profile ? null : $gateway.get()
+
+  if (!profile && !gateway) {
+    throw new Error('No session gateway is connected')
+  }
+
+  const release = profile
+    ? await retainGatewayForAgent(isSessionOwnerRoute(owner) ? owner.connectionId : null, profile, {
+        spawnPriority: 'foreground'
+      })
+    : () => undefined
+
+  let released = false
+
+  return {
+    request<T>(method: string, params: Record<string, unknown> = {}, timeoutMs?: number): Promise<T> {
+      if (released) {
+        return Promise.reject(new Error('Session request lease has been released'))
+      }
+
+      return requestForSessionProfile<T>(
+        owner,
+        <R>(requestMethod: string, requestParams?: Record<string, unknown>, requestTimeout?: number) =>
+          gateway
+            ? gateway.request<R>(requestMethod, requestParams, requestTimeout)
+            : Promise.reject(new Error('No session gateway is connected')),
+        method,
+        params,
+        timeoutMs
+      )
+    },
+    release(): void {
+      if (!released) {
+        released = true
+        release()
+      }
+    }
