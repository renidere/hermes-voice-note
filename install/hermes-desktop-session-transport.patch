+  lease.release()
+})
+
+it('refuses admitted legacy topology when there is no actual gateway to capture', async () => {
+  const { retainPluginSession: retainSession } = await import('./session-request')
+  seams.registry = false
+  seams.profiles = ['default']
+  seams.resolve.mockResolvedValue(undefined)
+  seams.gateway = null
+  await expect(retainSession('stored-original')).rejects.toThrow('gateway')
+  expect(seams.retain).not.toHaveBeenCalled()
+})
+
+it('preserves resolver, retain, and request errors without logging or substituting another route', async () => {
+  const { retainPluginSession: retainSession } = await import('./session-request')
+  const error = new Error('synthetic private failure')
+  seams.resolve.mockRejectedValueOnce(error)
+  await expect(retainSession('stored-original')).rejects.toBe(error)
+  expect(seams.retain).not.toHaveBeenCalled()
+  seams.retain.mockRejectedValueOnce(error)
+  await expect(retainSession('stored-original')).rejects.toBe(error)
+  expect(seams.release).not.toHaveBeenCalled()
