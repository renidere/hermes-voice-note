+    sessionId: 'stored-original',
+    method: 'session.resume'
+  })
+  expect(seams.retain).not.toHaveBeenCalled()
+  expect(seams.exact).not.toHaveBeenCalled()
+  expect(seams.profile).not.toHaveBeenCalled()
+  expect(seams.ambient).not.toHaveBeenCalled()
+})
+
+it('captures the admitted legacy sole gateway instead of re-reading the moving ambient socket', async () => {
+  const { retainPluginSession: retainSession } = await import('./session-request')
+  seams.registry = false
+  seams.profiles = ['default']
+  seams.resolve.mockResolvedValue(undefined)
+  const original = seams.gateway
+  const lease = await retainSession('stored-original')
+  const other = vi.fn()
+  seams.gateway = { request: other }
