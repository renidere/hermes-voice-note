+  expect(seams.ambient).not.toHaveBeenCalled()
+  lease.release()
+})
+
+it.each([true, false])('refuses unresolved ownership in ambiguous topology (registry=%j)', async registry => {
+  const { retainPluginSession: retainSession } = await import('./session-request')
+  seams.registry = registry
+  seams.resolve.mockResolvedValue(undefined)
