+import { beforeEach, expect, it, vi } from 'vitest'
+
+const seams = vi.hoisted(() => ({
+  resolve: vi.fn(),
+  retain: vi.fn(),
+  release: vi.fn(),
+  exact: vi.fn(),
+  profile: vi.fn(),
+  ambient: vi.fn(),
+  gateway: null as null | { request: ReturnType<typeof vi.fn> },
+  registry: true,
+  profiles: ['default', 'worker']
+}))
+
+vi.mock('@/app/session/hooks/use-session-actions/utils', () => ({ resolveSessionOwner: seams.resolve }))
+vi.mock('@/store/gateway', () => ({
+  $gateway: { get: () => seams.gateway },
+  retainGatewayForAgent: seams.retain,
+  requestGatewayForAgent: seams.exact,
+  requestGatewayForProfile: seams.profile,
+  retainGatewayForSessionTurn: vi.fn()
+}))
+vi.mock('@/store/connection-registry-state', () => ({ hasRegistryTopology: () => seams.registry }))
+vi.mock('@/store/profile', () => ({ $profiles: { get: () => seams.profiles } }))
+vi.mock('@/store/session-gone-latch', () => ({ resetBackgroundPollingGuardAfterRebind: vi.fn() }))
+
+beforeEach(() => {
+  vi.resetAllMocks()
+  seams.registry = true
+  seams.profiles = ['default', 'worker']
+  seams.gateway = { request: seams.ambient }
+  seams.ambient.mockResolvedValue({ ok: true })
+  seams.profile.mockResolvedValue({ ok: true })
+  seams.resolve.mockResolvedValue({ connectionId: 'original-server', profile: 'worker' })
+  seams.retain.mockResolvedValue(seams.release)
+  seams.exact.mockImplementation(async (_connection, _profile, method) =>
+    method === 'session.resume' ? { session_id: 'runtime-original' } : { ref_text: '@file:voice.wav' }
+  )
+})
+
+it('resolves the original durable id once and holds its native route across resume and attach', async () => {
+  const { retainPluginSession: retainSession } = await import('./session-request')
+  const lease = await retainSession('stored-original', null)
+  // Focus and the resolver answer can move after acquisition; the lease must not.
+  seams.resolve.mockResolvedValue({ connectionId: 'focused-elsewhere', profile: 'default' })
+  const resumed = await lease.request<{ session_id: string }>('session.resume', { session_id: 'stored-original' })
+  await expect(
+    lease.request('file.attach', { session_id: resumed.session_id, data_url: 'data:audio/wav;base64,AA==' }, 1234)
+  ).resolves.toEqual({ ref_text: '@file:voice.wav' })
+  expect(seams.resolve).toHaveBeenCalledExactlyOnceWith('stored-original')
+  expect(seams.retain).toHaveBeenCalledExactlyOnceWith('original-server', 'worker', { spawnPriority: 'foreground' })
+  expect(seams.exact.mock.calls).toEqual([
+    ['original-server', 'worker', 'session.resume', { session_id: 'stored-original' }],
+    [
+      'original-server',
+      'worker',
+      'file.attach',
+      { session_id: 'runtime-original', data_url: 'data:audio/wav;base64,AA==' },
+      1234,
+      undefined
+    ]
+  ])
+  lease.release()
+  lease.release()
+  expect(seams.release).toHaveBeenCalledTimes(1)
+  await expect(lease.request('file.attach')).rejects.toThrow('released')
+  expect(seams.exact).toHaveBeenCalledTimes(2)
+})
+
+it.each(['', '   ', null, 4])('rejects an invalid durable id %j before resolving or dialing', async id => {
+  const { retainPluginSession: retainSession } = await import('./session-request')
+  await expect(retainSession(id as string)).rejects.toThrow('stored session id')
+  expect(seams.resolve).not.toHaveBeenCalled()
+  expect(seams.retain).not.toHaveBeenCalled()
+})
+
+it.each([
+  {},
+  { connectionId: '', profile: 'worker' },
+  { connectionId: 'server', profile: '' },
+  { connectionId: 4, profile: 'worker' },
+  { connectionId: ' server', profile: 'worker' },
+  { connectionId: 'server', profile: 'worker ' }
+])('rejects malformed captured owner %j without resolving or dialing', async owner => {
+  const { retainPluginSession: retainSession } = await import('./session-request')
+  await expect(retainSession('stored-original', owner as never)).rejects.toThrow('Session owner')
+  expect(seams.resolve).not.toHaveBeenCalled()
+  expect(seams.retain).not.toHaveBeenCalled()
+})
+
+it('copies the captured exact owner before the first await and does not re-resolve', async () => {
+  const { retainPluginSession: retainSession } = await import('./session-request')
+  const owner = { connectionId: 'captured', profile: 'worker' }
+  const pending = retainSession(' stored-original ', owner)
+  owner.connectionId = 'changed'
+  owner.profile = 'changed'
+  const lease = await pending
+  await lease.request('session.resume', { session_id: ' stored-original ' })
